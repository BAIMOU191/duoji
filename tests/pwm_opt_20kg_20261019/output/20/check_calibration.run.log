/* ==================== 2. 电机标定（标定固件打印，整节替换） ====================

 * 电压域模型 U = kv·ω + ka·α + fc·sgn(ω)，静止且 |U| < fs 时粘住；参数与母线电压无关，

 * 运行时电压按实测母线换算成占空比。额定能力为标定电压下的值(已留10%余量)，只用于配置校验与出厂默认值。

 * 本节由 7.67V 实测标定生成：tau=27.5ms，两向kv 349/349 µV，拟合点48。

 * 诊断：最小步长 缓升法22(6次)/脉冲法19，读数峰峰0，制动出力比106%(已计入额定减速度)。 */

#define MOTOR_CAL_MV              7670   /* 标定电压，mV */

#define MOTOR_KV_UV                349   /* 反电势斜率，µV/(厘度/s) */

#define MOTOR_KA_NV               9591   /* 加速系数，nV/(厘度/s²) */

#define MOTOR_FC_MV                 37   /* 动摩擦，mV */

#define MOTOR_FS_MV                498   /* 起转电压，mV */

#define MOTOR_DELAY_US            4023   /* 输入到响应的纯延迟，µs */

#define MOTOR_NOISE_CDEG             1   /* 静止读数噪声幅值(±)，厘度 */

#define MOTOR_MIN_STEP_CDEG         22   /* 最小可靠位移，厘度 */

#define MOTOR_SIGN                   1   /* 正电压使输出轴角度增大 = 1 */

#define MOTOR_RATED_VEL_DPS        197   /* 额定最高速度，度/秒 */

#define MOTOR_RATED_ACC_DPS2      7158   /* 额定零速加速度，度/秒² */

#define MOTOR_RATED_DEC_DPS2      7639   /* 额定低速减速度，度/秒² */

/* ==================== 电机标定结束 ==================== */

