@@ -183,11 +185,6 @@
             limit += PROT_LIMIT_UP_STEP;
             if (limit > ceiling) limit = ceiling;
         }
-        else if (limit > ceiling)
-        {
-            limit -= PROT_LIMIT_UP_STEP;
-            if (limit < ceiling) limit = ceiling;
-        }
     }
 
     if (limit < PROT_LIMIT_MIN) limit = PROT_LIMIT_MIN;
@@ -262,8 +259,7 @@
  * @return  无
  *
  * 每拍复检扭矩状态而不是只在故障边沿动一次：故障期间上位机完全可能发来
